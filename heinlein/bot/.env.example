# Copy to heinlein/bot/.env and fill in. The real .env is git-ignored. Lars holds these; never paste them into chat.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Absolute path to the Claude Code CLI. Leave blank to use "claude" from PATH.
CLAUDE_CLI=
# Repo root. Defaults to the parent of the heinlein folder.
HEINLEIN_ROOT=
# Minutes a single headless job may run before it is killed.
HEINLEIN_JOB_TIMEOUT_MIN=15
